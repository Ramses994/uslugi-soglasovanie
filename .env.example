# ===== Общие =====
APP_ENV=dev
APP_SECRET_KEY=change-me-to-a-random-64-char-string
APP_BASE_URL=http://localhost:8000
JWT_EXPIRE_MINUTES=480

# ===== LDAP / Active Directory =====
# В dev-режиме (LDAP_MOCK=true) любой логин/пароль из LDAP_MOCK_USERS считается валидным —
# это позволяет разрабатывать и демонстрировать форму без боевого AD.
LDAP_MOCK=true
LDAP_SERVER=ldap://dc01.clinic.local
LDAP_DOMAIN=CLINIC
LDAP_BASE_DN=DC=clinic,DC=local
LDAP_USER_SEARCH_BASE=OU=Users,DC=clinic,DC=local
# Сервисная учётная запись только на ЧТЕНИЕ, используется для поиска атрибутов
# после успешного bind под учёткой самого пользователя (см. ldap_auth.py)
LDAP_SERVICE_USER=CLINIC\\svc-price-form
LDAP_SERVICE_PASSWORD=

# ===== SMTP =====
# Вариант A (рекомендуется): сервисный ящик + Reply-To на инициатора.
SMTP_HOST=mail.clinic.local
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=svc-price-form@clinic.local
SMTP_PASSWORD=
SMTP_FROM=Прейскурант МЕДИАЛОГ <svc-price-form@clinic.local>
# Вариант B: отправка от имени текущего пользователя (доменные креды пользователя
# передаются на бэкенд только в момент логина и НЕ сохраняются — см. раздел 6 ТЗ).
SMTP_SEND_AS_USER=false

# ===== Справочники =====
DICT_ERLU_KDL_PATH=./data/ERLU-KDL_13.10.25.xls
DICT_MINZDRAV_PATH=./data/minzdrav_nsi_1.2.643.5.1.13.13.11.1070.xlsx
DICT_REFRESH_ON_START=true

# ===== Согласующие (справочник маршрутизации, можно вынести в БД/AD-группу) =====
APPROVERS_JSON=./data/approvers.json

# ===== Филиалы (редактируются через роль "Администратор формы") =====
BRANCHES_JSON=./data/branches.json

# ===== База данных (журнал заявок) =====
DATABASE_URL=sqlite:///./data/requests.db

# ===== Роль "Администратор формы" =====
# Логины через запятую, регистр не важен. В бою — заменить на проверку членства
# в AD-группе (например, CN=PriceFormAdmins), см. раздел 10 ТЗ.md.
# В dev/демо режиме (LDAP_MOCK=true) удобно указать сюда тестового пользователя
# ivanov, чтобы сразу увидеть вкладку администрирования после логина.
FORM_ADMIN_LOGINS=ivanov

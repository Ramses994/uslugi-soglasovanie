# ===== Общие =====
APP_ENV=dev
APP_SECRET_KEY=change-me-to-a-random-64-char-string
APP_BASE_URL=http://localhost:8000
JWT_EXPIRE_MINUTES=480

# Порт хоста для Docker-деплоя (см. docker-compose.yml) — читается САМИМ
# docker compose из .env в корне проекта, не приложением. По умолчанию 8000:
# на 192.168.2.104 порт 80 уже занят Zabbix. Если на вашем сервере 80
# свободен и форма должна открываться без порта в адресе — раскомментируйте:
# APP_PORT=80

# ===== LDAP / Active Directory =====
# В dev-режиме (LDAP_MOCK=true) любой логин/пароль из LDAP_MOCK_USERS считается валидным —
# это позволяет разрабатывать и демонстрировать форму без боевого AD.
LDAP_MOCK=true
LDAP_SERVER=ldap://dc01.clinic.local
LDAP_DOMAIN=CLINIC
# UPN-суффикс для входа голым логином (без домена/@) — раньше был захардкожен как
# "{LDAP_DOMAIN}.local" в коде, что ломалось на любом домене не в зоне .local.
# Обычно совпадает с DNS-именем домена AD.
LDAP_UPN_SUFFIX=clinic.local
# Форсировать LDAPS (порт 636), даже если LDAP_SERVER начинается с ldap://.
# Боевые AD (примерно с 2020 г. патчей) часто требуют LDAP signing/channel binding —
# обычный bind по ldap:// в таком случае отклоняется как "неверный пароль" ДАЖЕ
# ПРИ ВЕРНОМ ПАРОЛЕ. Надёжнее всего просто использовать ldaps:// в LDAP_SERVER —
# тогда эту переменную можно оставить false, схема определится сама.
LDAP_USE_SSL=false
LDAP_BASE_DN=DC=clinic,DC=local
LDAP_USER_SEARCH_BASE=OU=Users,DC=clinic,DC=local
# Сервисная учётная запись только на ЧТЕНИЕ — используется (1) для поиска атрибутов
# после успешного bind под учёткой самого пользователя и (2) для поиска по каталогу
# при подборе согласующих во вкладке «Администрирование» (см. ldap_auth.py).
# Без неё вкладка «Администрирование» по-прежнему работает, но поиск по AD в ней — нет
# (согласующих придётся вбивать вручную, как раньше).
LDAP_SERVICE_USER=CLINIC\\svc-price-form
LDAP_SERVICE_PASSWORD=
# Показывать в подборе согласующих только учётки с почтой в этом домене — пусто
# значит без фильтра (могут попасться служебные учётки без реальной переписки).
LDAP_DIRECTORY_MAIL_SUFFIX=@clinic.local

# ---- Пример для боевого домена MEDKVADRAT (см. раздел 12.9 ТЗ.md) ----
# LDAP_MOCK=false
# LDAP_SERVER=ldaps://<хост_контроллера_домена>.medkvadrat.ru
# LDAP_DOMAIN=MEDKVADRAT
# LDAP_UPN_SUFFIX=medkvadrat.ru
# LDAP_BASE_DN=DC=medkvadrat,DC=ru
# LDAP_USER_SEARCH_BASE=DC=medkvadrat,DC=ru
# LDAP_SERVICE_USER=MEDKVADRAT\\svc-price-form
# LDAP_SERVICE_PASSWORD=<пароль сервисной учётки>
# LDAP_DIRECTORY_MAIL_SUFFIX=@medkvadrat.ru
# Значения LDAP_SERVER/LDAP_BASE_DN/LDAP_USER_SEARCH_BASE здесь — примерные по
# соглашениям именования AD, не проверенные против реального контроллера домена
# MEDKVADRAT (у меня нет доступа к этой сети) — перед первым включением сверьте
# их с ИТ-отделом клиники, см. чек-лист диагностики в cursor_update_prompt.md.

# ===== SMTP =====
# Вариант A (рекомендуется): сервисный ящик + Reply-To на инициатора.
SMTP_HOST=mail.clinic.local
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=svc-price-form@clinic.local
SMTP_PASSWORD=
SMTP_FROM=Прейскурант МЕДИАЛОГ <svc-price-form@clinic.local>
# Вариант B: отправка от имени текущего пользователя (доменные креды пользователя
# передаются на бэкенд только в момент логина и НЕ сохраняются — см. раздел 6 ТЗ).
SMTP_SEND_AS_USER=false

# ===== Справочники =====
DICT_ERLU_KDL_PATH=./data/ERLU-KDL_13.10.25.xls
DICT_MINZDRAV_PATH=./data/minzdrav_nsi_1.2.643.5.1.13.13.11.1070.xlsx
DICT_REFRESH_ON_START=true

# ===== Согласующие (справочник маршрутизации, можно вынести в БД/AD-группу) =====
APPROVERS_JSON=./data/approvers.json

# ===== Филиалы (редактируются через роль "Администратор формы") =====
BRANCHES_JSON=./data/branches.json

# ===== База данных (журнал заявок) =====
DATABASE_URL=sqlite:///./data/requests.db

# ===== Роль "Администратор формы" =====
# Логины через запятую, регистр не важен. В бою — заменить на проверку членства
# в AD-группе (например, CN=PriceFormAdmins), см. раздел 10 ТЗ.md.
# В dev/демо режиме (LDAP_MOCK=true) удобно указать сюда тестового пользователя
# ivanov, чтобы сразу увидеть вкладку администрирования после логина.
FORM_ADMIN_LOGINS=ivanov

# Адреса для письма с файлом импорта в МИС (через запятую), если админ формы
# есть в FORM_ADMIN_LOGINS, но его нет в справочнике согласующих.
# MIS_NOTIFY_EMAILS=dmartynov@medkvadrat.ru
